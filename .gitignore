# Rust build artifacts
target/

# Node dependencies and local build caches
node_modules/
/.npm/
/.parcel-cache/
/web/.vite/

# IDE and editor files
/.opencode
/.serena
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json
!/.vscode/extensions.json
!/.vscode/settings.json
!/.vscode/README.md
!/.vscode/BACKEND_DEBUG.md
/.idea
*.swp
*.swo
*~

# Git worktrees and temp
/.worktrees
/.tmp*/
/Arcadestr/.tmp/

# Claude Code local workspace: machine-specific settings.local.json and
# scratch worktrees. No shared configuration is tracked under it.
/.claude/

# Tauri auto-generated files
/desktop/gen/

# Web build output (Trunk)
/web/dist/
/web/.arcadestr-frontend-build.txt

# Root-level runtime/test SQLite files; keep fixture directories visible
/*.db
/*.db-wal
/*.db-shm
/*.db-journal
/*.sqlite
/*.sqlite-wal
/*.sqlite-shm
/*.sqlite-journal
/*.sqlite3
