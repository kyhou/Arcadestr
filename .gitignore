/*.sqlite3-shm
/*.sqlite3-journal
/desktop/arcadestr.db
/desktop/arcadestr.db-wal
/desktop/arcadestr.db-shm
/desktop/arcadestr.db-journal
/data/

# Environment files
.env
.env.*
!.env.example

# OS-specific files
.DS_Store
Thumbs.db

# Log files
*.log

# V8 compile cache
v8-compile-cache-*/

