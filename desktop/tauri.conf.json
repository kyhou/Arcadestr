{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcadestr",
  "version": "0.1.0",
  "identifier": "com.arcadestr.app",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "cargo run -p arcadestr-xtask -- frontend-build --release",
      "cwd": ".."
    },
    "devUrl": "http://localhost:5173/?tauri-dev=1",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Arcadestr",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
